{
	"name": "@jigjoy/mozaik-network",
	"version": "0.1.0",
	"description": "Join a Mozaik network as a peer: connect, send and receive messages, and react to them by rules.",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jigjoy-ai/mozaik-network.git",
		"directory": "packages/client"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"peerDependencies": {
		"@jigjoy/mozaik-rule-engine": "^0.0.2"
	},
	"devDependencies": {
		"@jigjoy/mozaik-rule-engine": "^0.0.2"
	}
}
